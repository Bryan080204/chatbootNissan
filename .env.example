# ============================================================
#  Chatbot Nissan - Variables de entorno
#  Copia este archivo a  .env  y completa los valores.
# ============================================================

# Entorno: development | production
NODE_ENV=development

# Puerto del backend (dev.js expone el frontend en el 3000)
PORT=3001

# Clave para firmar la sesión (OBLIGATORIA).
# Genera una cadena larga y aleatoria, por ejemplo:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=coloca_aqui_una_clave_larga_y_aleatoria

# --- SQL Server ---
DB_SERVER=localhost
DB_DATABASE=ChatbotNissan
DB_USER=sa
DB_PASSWORD=tu_password

# --- WhatsApp Cloud API (Meta) ---
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id
WHATSAPP_ACCESS_TOKEN=tu_access_token
VERIFY_TOKEN=token_de_verificacion_del_webhook

# --- Google Gemini ---
GEMINI_API_KEY=tu_api_key_de_gemini
